# Copy this file to .env.properties and fill in the values.
#
# Every variable below is referenced from an autodeployed plugin configuration in
# backend/app/src/main/resources/config/plugin. Those configurations are deployed on every startup, and a
# variable that cannot be resolved aborts startup with:
#
#   java.lang.IllegalStateException: Failed to find environment variable: '<NAME>'
#
# So leave none of them out, and check this file again after pulling changes.

# Xential taakapplicatie credentials and the address of the ESB that fronts Xential.
XENTIAL_ACCOUNT_NAME=test
XENTIAL_ACCOUNT_PASSWORD=123
XENTIAL_BASEURL=http://localhost:1080
XENTIAL_GEBRUIKERS_ID=00000000-0000-0000-0000-000000000000
XENTIAL_TEMPLATE_GROUP_ID=11111111-1111-1111-1111-111111111111

# Shared secret that incoming document callbacks are signed with. Xential signs the callback as
# HMAC-SHA256(secret, documentCreatieSessieId + data) and sends it in the X-Xential-Signature header.
# Any non-empty string works locally; both sides just have to use the same one.
XENTIAL_CALLBACK_SECRET=local-development-secret

# Client certificate the application presents to the ESB, as base64 encoded PEM. All three are mandatory:
# the mTLS SSLContext plugin marks them as required, so leaving them blank also aborts startup.
#
# The ESB is not reachable from a local machine, so for local use a throwaway self-signed pair is enough:
#
#   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 30 -nodes -subj "/CN=localhost"
#   base64 -i cert.pem   # paste into MTLS_SSLCTX_SERVER_CERT_BASE64 and MTLS_SSLCTX_CLIENT_CERT_BASE64
#   base64 -i key.pem    # paste into MTLS_SSLCTX_PRIVATE_KEY_BASE64
#
# Paste each value as a single line, without line breaks. Never commit the result: .env.properties is
# gitignored for that reason.
MTLS_SSLCTX_SERVER_CERT_BASE64=
MTLS_SSLCTX_PRIVATE_KEY_BASE64=
MTLS_SSLCTX_CLIENT_CERT_BASE64=
